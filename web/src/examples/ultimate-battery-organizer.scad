    (!g_gen[i] || g_cols[i] < 1 || g_rows[i] < 1) ? 0 :
    (g_layouts[i] == 0)
        ? ((g_cols[i] - 1) * group_step_x(i) + ((g_rows[i] > 1) ? group_step_x(i)/2 : 0))
        : ((g_cols[i] - 1) * group_step_x(i));

function group_grid_d(i) =
    (!g_gen[i] || g_cols[i] < 1 || g_rows[i] < 1) ? 0 :
    (g_rows[i] - 1) * group_step_y(i);

function group_content_w(i) = (!g_gen[i]) ? 0 : (group_grid_w(i) + group_Din_x(i));
function group_content_d(i) = (!g_gen[i]) ? 0 : (group_grid_d(i) + group_Din_y(i));
function group_batteries(i) =
    (!g_gen[i] || g_cols[i] < 1 || g_rows[i] < 1) ? 0 :
    (g_layouts[i] == 2)
        ? (ceil(g_rows[i]/2)*g_cols[i] + floor(g_rows[i]/2)*(g_cols[i]-1))
        : (g_cols[i] * g_rows[i]);

function group_pocket_depth(i) =
    let(bt = g_types[i])
    is_coin_type(bt) ? (box_type ? min(raw_w(i) / 2, max(0.5, fixed_box_height - top_bottom_thickness)) : (raw_w(i) / 2)) :
    (box_type ? max(0.5, fixed_box_height - top_bottom_thickness) :
    ((bt == 0 || bt == 1) ? get_h(i) : max(0.5, get_h(i) - fixed_battery_protrusion)));

active_indices = [for(i=[0:9]) if(g_gen[i] && g_cols[i] >= 1 && g_rows[i] >= 1) i];
num_active = len(active_indices);

function groups_in_row(r) = [for(i=active_indices) if(g_row[i] == r) i];
function calc_sum(v, i=0, acc=0) = (i >= len(v)) ? acc : calc_sum(v, i+1, acc + v[i]);

total_batteries = calc_sum([for(i=active_indices) group_batteries(i)]);
used_rows = [for(r=[1:3]) if(len(groups_in_row(r)) > 0) r];
num_layout_rows = len(used_rows);

function row_content_w(grp_list) =
    let(n = len(grp_list))
    (n == 0) ? 0 :
    calc_sum([for(i=grp_list) group_content_w(i)]) + (n > 1 ? (n-1)*group_distance_X : 0);

function row_content_d(grp_list) =
    (len(grp_list) == 0) ? 0 : max([for(i=grp_list) group_content_d(i)]);

center_w = (num_layout_rows == 0) ? 0 : max([for(r=used_rows) row_content_w(groups_in_row(r))]);
center_d = (num_layout_rows == 0) ? 0 : calc_sum([for(r=used_rows) row_content_d(groups_in_row(r))]) + (num_layout_rows > 1 ? (num_layout_rows-1)*group_distance_Y : 0);
left_col_groups = groups_in_row(4);
left_w = (len(left_col_groups) == 0) ? 0 : max([for(i=left_col_groups) group_content_w(i)]);
left_d = (len(left_col_groups) == 0) ? 0 : calc_sum([for(i=left_col_groups) group_content_d(i)]) + (len(left_col_groups) > 1 ? (len(left_col_groups)-1)*group_distance_Y : 0);
right_col_groups = groups_in_row(5);
right_w = (len(right_col_groups) == 0) ? 0 : max([for(i=right_col_groups) group_content_w(i)]);
right_d = (len(right_col_groups) == 0) ? 0 : calc_sum([for(i=right_col_groups) group_content_d(i)]) + (len(right_col_groups) > 1 ? (len(right_col_groups)-1)*group_distance_Y : 0);

total_content_w_calc = left_w + (left_w>0 && (center_w>0 || right_w>0) ? group_distance_X : 0) + center_w + (center_w>0 && right_w>0 ? group_distance_X : 0) + right_w;
total_content_w = (total_content_w_calc == 0) ? 50 : total_content_w_calc;
total_content_d_calc = max(center_d, max(left_d, right_d));
total_content_d = (total_content_d_calc == 0) ? 50 : total_content_d_calc;

box_margin = max(1.0, group_separators);

max_height = (num_active == 0) ? 50.5 : max([for(i=active_indices) get_h(i)]);
max_pocket = (num_active == 0) ? (box_type ? max(0.5, fixed_box_height - top_bottom_thickness) : max(0.5, 50.5 - fixed_battery_protrusion)) : max([for(i=active_indices) group_pocket_depth(i)]);
box_height = box_type ? max(fixed_box_height, top_bottom_thickness + 0.5) : (top_bottom_thickness + max_pocket);
max_actual_protrusion = (num_active == 0) ? (box_type ? (50.5 - max_pocket) : fixed_battery_protrusion) : max([for(i=active_indices) (get_h(i) - group_pocket_depth(i))]);
lid_height = max(outer_wall_thickness + lid_lip_height, max_actual_protrusion + outer_wall_thickness + lid_lip_height + lid_battery_clearance);

box_w = total_content_w + 2 * box_margin + 2 * outer_wall_thickness;
box_d = total_content_d + 2 * box_margin + 2 * outer_wall_thickness;
lip_outer_w = box_w - 2 * lid_lip_thickness;
lip_outer_d = box_d - 2 * lid_lip_thickness;
lip_radius = max(0.01, corner_radius - lid_lip_thickness);

content_origin_x = -total_content_w / 2;
content_origin_y = -total_content_d / 2;

wall_left = content_origin_x - box_margin;
wall_right = content_origin_x + total_content_w + box_margin;
wall_bottom = content_origin_y - box_margin;
wall_top = content_origin_y + total_content_d + box_margin;

function align_start(free_sp, n, sep, effective_align=-1) =
    let(
        a = (effective_align >= 0) ? effective_align : align,
        extra = free_sp - (n-1)*sep
    )
    (a == 0 || n <= 1 || extra <= 0.01) ? extra / 2 :
    (a == 1 ? 0 : extra / (n+1));

function align_gap(free_sp, n, sep, effective_align=-1) =
    let(
        a = (effective_align >= 0) ? effective_align : align,
        extra = free_sp - (n-1)*sep
    )
    (a == 0 || n <= 1 || extra <= 0.01) ? sep :
    (a == 1 ? free_sp / (n-1) : sep + extra / (n+1));

left_used_y = calc_sum([for(i=left_col_groups) group_content_d(i)]);
left_free_y = total_content_d - left_used_y;
left_gap_y = align_gap(left_free_y, len(left_col_groups), group_distance_Y);
left_start_y = content_origin_y + align_start(left_free_y, len(left_col_groups), group_distance_Y);

right_used_y = calc_sum([for(i=right_col_groups) group_content_d(i)]);
right_free_y = total_content_d - right_used_y;
right_gap_y = align_gap(right_free_y, len(right_col_groups), group_distance_Y);
right_start_y = content_origin_y + align_start(right_free_y, len(right_col_groups), group_distance_Y);

center_used_y = calc_sum([for(r=used_rows) row_content_d(groups_in_row(r))]);
center_free_y = total_content_d - center_used_y;
center_gap_y = align_gap(center_free_y, num_layout_rows, group_distance_Y, align == 2 ? 1 : align);
center_start_y = content_origin_y + align_start(center_free_y, num_layout_rows, group_distance_Y, align == 2 ? 1 : align);

center_start_x = content_origin_x + (left_w > 0 ? left_w + group_distance_X : 0);
right_start_x = center_start_x + (center_w > 0 ? center_w + group_distance_X : 0);

function row_y_offset(idx) =
    (idx == 0) ? 0 :
    row_y_offset(idx-1) + row_content_d(groups_in_row(used_rows[idx-1])) + center_gap_y;

function cum_x_in_row(grp_list, k, gap_w) =
    (k <= 0) ? 0 :
    cum_x_in_row(grp_list, k-1, gap_w) + group_content_w(grp_list[k-1]) + gap_w;

function group_positions() = concat(
    [for(k=[0:len(left_col_groups)-1])
        let(i = left_col_groups[k],
            y_offset = (k==0) ? 0 : calc_sum([for(j=[0:k-1]) group_content_d(left_col_groups[j])]) + k*left_gap_y,
            gx = (align == 1) ? content_origin_x + group_content_w(i)/2 : content_origin_x + left_w/2,
            gy = left_start_y + y_offset + group_content_d(i)/2)
        [i, gx, gy]],
    [for(ri=[0:num_layout_rows-1])
        for(k=[0:len(groups_in_row(used_rows[ri]))-1])
            let(r = used_rows[ri],
                grp_list = groups_in_row(r),
                row_d = row_content_d(grp_list),
                used_w = calc_sum([for(g=grp_list) group_content_w(g)]),
                free_w = center_w - used_w,
                gap_w = align_gap(free_w, len(grp_list), group_distance_X),
                start_w = align_start(free_w, len(grp_list), group_distance_X),
                row_start_x = center_start_x + start_w,
                row_start_y = center_start_y + row_y_offset(ri),
                i = grp_list[k],
                gx = row_start_x + cum_x_in_row(grp_list, k, gap_w) + group_content_w(i)/2,
gy = (align == 1 && r == 1) ? row_start_y + group_content_d(i)/2 :
                         (align == 1 && r == 3) ? row_start_y + row_d - group_content_d(i)/2 :
                         row_start_y + row_d/2)
            [i, gx, gy]],
    [for(k=[0:len(right_col_groups)-1])
        let(i = right_col_groups[k],
            y_offset = (k==0) ? 0 : calc_sum([for(j=[0:k-1]) group_content_d(right_col_groups[j])]) + k*right_gap_y,
            gx = (align == 1) ? right_start_x + right_w - group_content_w(i)/2 : right_start_x + right_w/2,
            gy = right_start_y + y_offset + group_content_d(i)/2)
        [i, gx, gy]]
);

function label_positions() = concat(
    [for(k=[0:len(left_col_groups)-1])
        let(
            i = left_col_groups[k],
            c_xmin = wall_left,
            c_xmax = (left_w > 0 && (center_w > 0 || right_w > 0)) ? content_origin_x + left_w + group_distance_X/2 : wall_right,
            c_ymin = (k == 0) ? wall_bottom : left_start_y + calc_sum([for(j=[0:k-1]) group_content_d(left_col_groups[j])]) + k*left_gap_y - left_gap_y/2,
            c_ymax = (k == len(left_col_groups)-1) ? wall_top : left_start_y + calc_sum([for(j=[0:k]) group_content_d(left_col_groups[j])]) + (k+1)*left_gap_y - left_gap_y/2,
            lx = (c_xmin + c_xmax) / 2,
            ly = (c_ymin + c_ymax) / 2
        )
        [i, lx, ly, c_xmin, c_xmax, c_ymin, c_ymax]
    ],
    [for(ri=[0:num_layout_rows-1])
        for(k=[0:len(groups_in_row(used_rows[ri]))-1])
            let(
                r = used_rows[ri],
                grp_list = groups_in_row(r),
                i = grp_list[k],
                used_w = calc_sum([for(g=grp_list) group_content_w(g)]),
                free_w = center_w - used_w,
                gap_w = align_gap(free_w, len(grp_list), group_distance_X),
                start_w = align_start(free_w, len(grp_list), group_distance_X),
                row_start_x = center_start_x + start_w,
                c_xmin = (k == 0) ? ((left_w > 0) ? content_origin_x + left_w + group_distance_X/2 : wall_left) : row_start_x + cum_x_in_row(grp_list, k-1, gap_w) + group_content_w(grp_list[k-1]) + gap_w/2,
                c_xmax = (k == len(grp_list)-1) ? ((right_w > 0) ? center_start_x + center_w + group_distance_X/2 : wall_right) : row_start_x + cum_x_in_row(grp_list, k, gap_w) + group_content_w(grp_list[k]) + gap_w/2,
                c_ymin = (ri == 0) ? wall_bottom : center_start_y + row_y_offset(ri-1) + row_content_d(groups_in_row(used_rows[ri-1])) + center_gap_y/2,
                c_ymax = (ri == num_layout_rows-1) ? wall_top : center_start_y + row_y_offset(ri) + row_content_d(groups_in_row(used_rows[ri])) + center_gap_y/2,
                lx = (c_xmin + c_xmax) / 2,
                ly = (c_ymin + c_ymax) / 2
            )
            [i, lx, ly, c_xmin, c_xmax, c_ymin, c_ymax]
    ],
    [for(k=[0:len(right_col_groups)-1])
        let(
            i = right_col_groups[k],
            c_xmin = (center_w > 0) ? center_start_x + center_w + group_distance_X/2 : ((left_w > 0) ? content_origin_x + left_w + group_distance_X/2 : wall_left),
            c_xmax = wall_right,
            c_ymin = (k == 0) ? wall_bottom : right_start_y + calc_sum([for(j=[0:k-1]) group_content_d(right_col_groups[j])]) + k*right_gap_y - right_gap_y/2,
            c_ymax = (k == len(right_col_groups)-1) ? wall_top : right_start_y + calc_sum([for(j=[0:k]) group_content_d(right_col_groups[j])]) + (k+1)*right_gap_y - right_gap_y/2,
            lx = (c_xmin + c_xmax) / 2,
            ly = (c_ymin + c_ymax) / 2
        )
        [i, lx, ly, c_xmin, c_xmax, c_ymin, c_ymax]
    ]
);

echo(str("------------------------- DIMENSIONS -------------------------"));
echo(str("ACTIVE GROUPS: ", num_active));
for(k=[0:num_active-1]) {
    i = active_indices[k];
    echo(str(" Group ", i+1, " (pos ", g_row[i], "): ", group_batteries(i), "x ", get_name(i),
             " (", get_w(i), "x", get_d(i), "x", get_h(i), " mm)"));
}
echo(str("TOTAL BATTERIES: ", total_batteries));
echo(str("BOX: X = ", box_w, " mm, Y = ", box_d, " mm, Z = ", box_height, " mm"));
if (enable_lid) {
    echo(str("LID: X = ", box_w, " mm, Y = ", box_d, " mm, Z = ", lid_height, " mm"));
    echo(str("TOTAL ASSEMBLED HEIGHT: ", box_height + lid_height - lid_lip_height, " mm"));
}
echo(str("-------------------------------------------------------------------"));

module box_profile(w, d, h, r, b_chamfer, t_chamfer) {
    r_bottom = max(0.01, r - b_chamfer);
    cb_x = max(r, b_chamfer);
    cb_y = max(r, b_chamfer);
    r_top = max(0.01, r - t_chamfer);
    ct_x = max(r, t_chamfer);
    ct_y = max(r, t_chamfer);
    translate([-w/2, -d/2, 0])
        hull() {
            translate([cb_x, cb_y, 0]) cylinder(r=r_bottom, h=eps, $fn=corner_fn);
            translate([w-cb_x, cb_y, 0]) cylinder(r=r_bottom, h=eps, $fn=corner_fn);
            translate([cb_x, d-cb_y, 0]) cylinder(r=r_bottom, h=eps, $fn=corner_fn);
            translate([w-cb_x, d-cb_y, 0]) cylinder(r=r_bottom, h=eps, $fn=corner_fn);
            translate([r, r, b_chamfer]) cylinder(r=r, h=eps, $fn=corner_fn);
            translate([w-r, r, b_chamfer]) cylinder(r=r, h=eps, $fn=corner_fn);
            translate([r, d-r, b_chamfer]) cylinder(r=r, h=eps, $fn=corner_fn);
            translate([w-r, d-r, b_chamfer]) cylinder(r=r, h=eps, $fn=corner_fn);
            translate([r, r, h-t_chamfer-eps]) cylinder(r=r, h=eps, $fn=corner_fn);
            translate([w-r, r, h-t_chamfer-eps]) cylinder(r=r, h=eps, $fn=corner_fn);
            translate([r, d-r, h-t_chamfer-eps]) cylinder(r=r, h=eps, $fn=corner_fn);
            translate([w-r, d-r, h-t_chamfer-eps]) cylinder(r=r, h=eps, $fn=corner_fn);
            translate([ct_x, ct_y, h-eps]) cylinder(r=r_top, h=eps, $fn=corner_fn);
            translate([w-ct_x, ct_y, h-eps]) cylinder(r=r_top, h=eps, $fn=corner_fn);
            translate([ct_x, d-ct_y, h-eps]) cylinder(r=r_top, h=eps, $fn=corner_fn);
            translate([w-ct_x, d-ct_y, h-eps]) cylinder(r=r_top, h=eps, $fn=corner_fn);
        }
}

module battery_slot(w, d, h, top_z, c_h, bt, custom_r = 0) {
    is_rectangular = (bt == 1 || bt == 13 || bt == 34 || is_coin_type(bt));
    if (is_coin_type(bt)) {
        union() {
            translate([0, d/2 + eps, w/2 + coin_slots_offset])
                rotate([90, 0, 0])
                    cylinder(d=w, h=d+2*eps, center=false, $fn=slot_fn);
            if (c_h <= 0) {
                translate([-w/2, -d/2, w/2 + coin_slots_offset])
                    cube([w, d, h - (w/2 + coin_slots_offset)]);
            } else {
                if (top_z > w/2 + coin_slots_offset) {
                    translate([-w/2, -d/2, w/2 + coin_slots_offset])
                        cube([w, d, top_z - (w/2 + coin_slots_offset)]);
                }
                translate([-w/2, -d/2, top_z - c_h])
                    hull() {
                        cube([w, d, eps]);
                        translate([-c_h, -c_h, c_h])
                            cube([w + 2*c_h, d + 2*c_h, eps]);
                    }
                translate([-w/2 - c_h, -d/2 - c_h, top_z])
                    cube([w + 2*c_h, d + 2*c_h, h - top_z]);
            }
        }
    }
    else if (!is_rectangular && abs(w - d) < 0.01) {
        if (c_h <= 0) {
            cylinder(d=w, h=h, $fn=slot_fn);
        } else {
            union() {
                cylinder(d=w, h=top_z, $fn=slot_fn);
                translate([0, 0, top_z - c_h])
                    cylinder(d1=w, d2=w + 2*c_h, h=c_h + eps, $fn=slot_fn);
                translate([0, 0, top_z])
                    cylinder(d=w + 2*c_h, h=h - top_z, $fn=slot_fn);
            }
        }
    } else {
        r = (bt == 1) ? max(0.01, min(custom_r, min(w, d)/2 - 0.01)) : max(0.1, min(2.5, min(w, d)/2 - 0.05));
        if (c_h <= 0) {
            translate([-w/2, -d/2, 0])
            hull() {
                translate([r, r, 0]) cylinder(r=r, h=h, $fn=small_fn);
                translate([w-r, r, 0]) cylinder(r=r, h=h, $fn=small_fn);
                translate([r, d-r, 0]) cylinder(r=r, h=h, $fn=small_fn);
                translate([w-r, d-r, 0]) cylinder(r=r, h=h, $fn=small_fn);
            }
        } else {
            union() {
                translate([-w/2, -d/2, 0])
                hull() {
                    translate([r, r, 0]) cylinder(r=r, h=top_z, $fn=small_fn);
                    translate([w-r, r, 0]) cylinder(r=r, h=top_z, $fn=small_fn);
                    translate([r, d-r, 0]) cylinder(r=r, h=top_z, $fn=small_fn);
                    translate([w-r, d-r, 0]) cylinder(r=r, h=top_z, $fn=small_fn);
                }
                translate([-w/2, -d/2, top_z - c_h])
                hull() {
                    translate([r, r, 0]) cylinder(r=r, h=eps, $fn=small_fn);
                    translate([w-r, r, 0]) cylinder(r=r, h=eps, $fn=small_fn);
                    translate([r, d-r, 0]) cylinder(r=r, h=eps, $fn=small_fn);
                    translate([w-r, d-r, 0]) cylinder(r=r, h=eps, $fn=small_fn);
                    translate([r, r, c_h]) cylinder(r=r+c_h, h=eps, $fn=small_fn);
                    translate([w-r, r, c_h]) cylinder(r=r+c_h, h=eps, $fn=small_fn);
                    translate([r, d-r, c_h]) cylinder(r=r+c_h, h=eps, $fn=small_fn);
                    translate([w-r, d-r, c_h]) cylinder(r=r+c_h, h=eps, $fn=small_fn);
                }
                translate([-w/2, -d/2, top_z])
                hull() {
                    translate([r, r, 0]) cylinder(r=r+c_h, h=h-top_z, $fn=small_fn);
                    translate([w-r, r, 0]) cylinder(r=r+c_h, h=h-top_z, $fn=small_fn);
                    translate([r, d-r, 0]) cylinder(r=r+c_h, h=h-top_z, $fn=small_fn);
                    translate([w-r, d-r, 0]) cylinder(r=r+c_h, h=h-top_z, $fn=small_fn);
                }
            }
        }
    }
}

module place_group_slots(i, cx, cy) {
    if (g_gen[i] && g_cols[i] >= 1 && g_rows[i] >= 1) {
        Din_x = group_Din_x(i);
        Din_y = group_Din_y(i);
        sx = group_step_x(i);
        sy = group_step_y(i);
        gw = group_grid_w(i);
        gd = group_grid_d(i);
        pocket = group_pocket_depth(i);
        floor_z = box_height - pocket;
        cut_h = pocket + top_bottom_thickness + 1;
        for(r = [0:g_rows[i]-1]) {
            offset_x = ((g_layouts[i] == 0 || g_layouts[i] == 2) && r % 2 == 1) ? sx / 2 : 0;
            cols_in_row = (g_layouts[i] == 2 && r % 2 == 1) ? g_cols[i] - 1 : g_cols[i];
            for(c = [0:cols_in_row-1]) {
                px = -gw/2 + c * sx + offset_x;
                py = -gd/2 + r * sy;
                translate([cx + px, cy + py, floor_z]) {
                    rot_angle = g_rot[i] ? 90 : 0;
                    rotate([0, 0, rot_angle])
                        battery_slot(raw_w(i) + g_clearance[i], raw_d(i) + g_clearance[i], cut_h, pocket, slot_chamfer, g_types[i], g_cust_r[i]);
                }
                if (enable_bottom_holes && !is_coin_type(g_types[i])) {
                    translate([cx + px, cy + py, -eps]) {
                        cylinder(d=bottom_holes_diameter, h=floor_z + 2*eps, $fn=slot_fn);
                    }
                }
            }
        }
    }
}

module group_label_content(name, count, avail_w = 500, avail_d = 500) {
    t_len = (label_type == 0) ? len(name) * label_text_size * 0.85 :
            (label_type == 1) ? len(str(name, " ", count)) * label_text_size * 0.85 :
            max(len(name), len(count)) * label_text_size * 0.85;
    t_h = (label_type == 2) ? label_text_size * 2.2 : label_text_size * 1.2;

    margin = 2.0;
    safe_w = avail_w - abs(border_offset * 2);
    safe_d = avail_d - abs(border_offset * 2);
    
    fits_h = (t_len + margin <= safe_w) && (t_h + margin <= safe_d);
    fits_v = (t_len + margin <= safe_d) && (t_h + margin <= safe_w);
    rot_angle = rotate_label_XY ? (fits_v ? 90 : (fits_h ? 0 : -1)) 
                                : (fits_h ? 0 : (fits_v ? 90 : -1));

    if (rot_angle != -1) {
        rotate([0, 0, rot_angle]) {
            if (label_type == 0) {
                text(name, size=label_text_size, halign="center", valign="center", font="Arial:style=Bold");
            } else if (label_type == 1) {
                text(str(name, " ", count), size=label_text_size, halign="center", valign="center", font="Arial:style=Bold");
            } else {
                translate([0, label_text_size * 0.6, 0])
                    text(name, size=label_text_size, halign="center", valign="center", font="Arial:style=Bold");
                translate([0, -label_text_size * 0.6, 0])
                    text(count, size=label_text_size, halign="center", valign="center", font="Arial:style=Bold");
            }
        }
    }
}

module place_group_label(i, cx, cy, avail_w, avail_d) {
    if (g_gen[i] && g_types[i] >= 3 && g_cols[i] >= 1 && g_rows[i] >= 1) {
        name = get_label_name(i);
        count = str("×", group_batteries(i));
        bt = g_types[i];
        pocket = group_pocket_depth(i);
        base_req = lid_lip_height + get_h(i) - pocket + lid_battery_clearance;
        global_ceiling = lid_height - outer_wall_thickness;
        is_lowered = (lid_separators == 2) && (is_coin_type(bt) || (bt >= 24 && bt <= 34)) && (base_req < global_ceiling - 0.1);
        actual_ceiling = is_lowered ? base_req : global_ceiling;
        translate([cx, cy, actual_ceiling - label_protrusion])
            linear_extrude(height = label_protrusion + eps)
                mirror([1, 0, 0])
                    rotate([0, 0, 180])
                        group_label_content(name, count, avail_w, avail_d);
    }
}

module group_border_2d(w, d, offset, thickness, r) {
    $fn = 64;
    outer_w = w + 2 * offset;
    outer_d = d + 2 * offset;
    outer_r = min(r, outer_w/2 - 0.01, outer_d/2 - 0.01);
    inner_w = outer_w - 2 * thickness;
    inner_d = outer_d - 2 * thickness;
    inner_r = max(0.01, min(outer_r - thickness, inner_w/2 - 0.01, inner_d/2 - 0.01));
    difference() {
        hull() {
            translate([ (outer_w/2 - outer_r), (outer_d/2 - outer_r)]) circle(r = outer_r);
            translate([ (outer_w/2 - outer_r), -(outer_d/2 - outer_r)]) circle(r = outer_r);
            translate([-(outer_w/2 - outer_r), (outer_d/2 - outer_r)]) circle(r = outer_r);
            translate([-(outer_w/2 - outer_r), -(outer_d/2 - outer_r)]) circle(r = outer_r);
        }
        if (inner_w > 2 * inner_r && inner_d > 2 * inner_r) {
            hull() {
                translate([ (inner_w/2 - inner_r), (inner_d/2 - inner_r)]) circle(r = inner_r);
                translate([ (inner_w/2 - inner_r), -(inner_d/2 - inner_r)]) circle(r = inner_r);
                translate([-(inner_w/2 - inner_r), (inner_d/2 - inner_r)]) circle(r = inner_r);
                translate([-(inner_w/2 - inner_r), -(inner_d/2 - inner_r)]) circle(r = inner_r);
            }
        }
    }
}

color("SteelBlue") {
    difference() {
        union() {
            box_profile(box_w, box_d, enable_lid ? (box_height - lid_lip_height) : box_height, corner_radius, down_chamfer, enable_lid ? 0 : top_chamfer);
            if (enable_lid) {
                translate([0, 0, box_height - lid_lip_height])
                    box_profile(lip_outer_w, lip_outer_d, lid_lip_height, lip_radius, 0, box_lip_chamfer);
            }
        }
        union() {
            for (p = group_positions()) place_group_slots(p[0], p[1], p[2]);
        }
    }
}

if (show_helpers) {
    color("White") {
        for (p = label_positions()) {
            let(
                i = p[0],
                lx = p[1], ly = p[2],
                xmin = p[3], xmax = p[4],
                ymin = p[5], ymax = p[6],
                w = xmax - xmin,
                d = ymax - ymin,
                th = 0.01
            ) {
                translate([0, 0, box_height + th/2]) {
                    if (xmin > wall_left + 0.1) translate([xmin, (ymin+ymax)/2, 0]) cube([lid_separator_thickness, d + lid_separator_thickness, th], center=true);
                    if (xmax < wall_right - 0.1) translate([xmax, (ymin+ymax)/2, 0]) cube([lid_separator_thickness, d + lid_separator_thickness, th], center=true);
                    if (ymin > wall_bottom + 0.1) translate([(xmin+xmax)/2, ymin, 0]) cube([w + lid_separator_thickness, lid_separator_thickness, th], center=true);
                    if (ymax < wall_top - 0.1) translate([(xmin+xmax)/2, ymax, 0]) cube([w + lid_separator_thickness, lid_separator_thickness, th], center=true);
                }
                
                if (g_gen[i] && g_cols[i] >= 1 && g_rows[i] >= 1) {
                    let(
                        pos_names = ["", "Down", "Center", "Up", "Left", "Right"],
                        pos_str = pos_names[g_row[i]]
                    )
                    translate([lx, ly, box_height])
                        linear_extrude(height = th)
                            scale([0.5, 0.5, 1]) {
                                translate([0, label_text_size * 0.6, 0])
                                    text(str("G", i+1, ":", pos_str), size=label_text_size, halign="center", valign="center", font="Arial:style=Bold");
                                translate([0, -label_text_size * 0.6, 0])
                                    text(str(get_label_name(i), " × ", group_batteries(i)), size=label_text_size, halign="center", valign="center", font="Arial:style=Bold");
                            }
                }
            }
        }
    }
}

if (enable_lid) {
    color("DarkOrange") {
        translate(assembly_view ? [0, 0, box_height - lid_lip_height + lid_fit_tolerance] : [0, box_d + 10, 0]) {
            translate(assembly_view ? [0, 0, 0] : [0, 0, lid_height])
            rotate(assembly_view ? [0, 0, 0] : [180, 0, 0])
            union() {
                difference() {
                    box_profile(box_w, box_d, lid_height, corner_radius, 0, top_chamfer);
                    translate([0, 0, -eps])
                        box_profile(box_w - 2*outer_wall_thickness, box_d - 2*outer_wall_thickness, lid_height - outer_wall_thickness + eps, max(0.1, corner_radius - outer_wall_thickness), 0, 0);
                    translate([0, 0, -eps])
                        box_profile(lip_outer_w + 2*lid_fit_tolerance, lip_outer_d + 2*lid_fit_tolerance, lid_lip_height + 2*eps, lip_radius + lid_fit_tolerance, 0, 0);
                    
                    if (custom_label != "") {
                        translate([0, 0, lid_height - label_depth])
                        linear_extrude(height = label_depth + eps)
                        rotate([0, 0, 0])
                            text(custom_label, size=custom_label_size, halign="center", valign="center", font="Arial:style=Bold");
                    }
                    
                    if (autogenerate_labels == 2) {
                        for (p = label_positions()) {
                            i = p[0];
                            if (g_gen[i] && g_types[i] >= 3 && g_cols[i] >= 1 && g_rows[i] >= 1) {
                                name = get_label_name(i);
                                count = str("×", group_batteries(i));
                                translate([p[1], p[2], lid_height - label_depth])
                                    linear_extrude(height = label_depth + eps)
                                        mirror([0, 0, 1])
                                            rotate([0, 0, 0])
                                                group_label_content(name, count, p[4]-p[3], p[6]-p[5]);
                            }
                        }
                    }

                    if (autogenerate_labels == 2) {
                        if (left_w > 0 && (center_w > 0 || right_w > 0)) {
                            translate([content_origin_x + left_w + group_distance_X/2, 0, lid_height - label_depth])
                                linear_extrude(height = label_depth + eps)
                                    square([label_border_thickness, total_content_d + 2 * border_offset], center = true);
                        }
                        if (right_w > 0 && center_w > 0) {
                            translate([center_start_x + center_w + group_distance_X/2, 0, lid_height - label_depth])
                                linear_extrude(height = label_depth + eps)
                                    square([label_border_thickness, total_content_d + 2 * border_offset], center = true);
                        }

                        if (len(left_col_groups) > 1) {
                            for(k = [0:len(left_col_groups)-2]) {
                                y_offset = calc_sum([for(j=[0:k-1]) group_content_d(left_col_groups[j])]) + k*left_gap_y;
                                translate([content_origin_x + left_w/2, left_start_y + y_offset + group_content_d(left_col_groups[k]) + left_gap_y/2, lid_height - label_depth])
                                    linear_extrude(height = label_depth + eps)
                                        square([left_w + 2 * border_offset, label_border_thickness], center = true);
                            }
                        }
                        if (len(right_col_groups) > 1) {
                            for(k = [0:len(right_col_groups)-2]) {
                                y_offset = calc_sum([for(j=[0:k-1]) group_content_d(right_col_groups[j])]) + k*right_gap_y;
                                translate([right_start_x + right_w/2, right_start_y + y_offset + group_content_d(right_col_groups[k]) + right_gap_y/2, lid_height - label_depth])
                                    linear_extrude(height = label_depth + eps)
                                        square([right_w + 2 * border_offset, label_border_thickness], center = true);
                            }
                        }
                        for(ri = [0:num_layout_rows-2]) {
                            r = used_rows[ri];
                            grp_list = groups_in_row(r);
                            row_d = row_content_d(grp_list);
                            y_center = center_start_y + row_y_offset(ri) + row_d + center_gap_y/2;
                            translate([center_start_x + center_w/2, y_center, lid_height - label_depth])
                                linear_extrude(height = label_depth + eps)
                                    square([center_w + 2 * border_offset, label_border_thickness], center = true);
                        }
                        for(ri = [0:num_layout_rows-1]) {
                            r = used_rows[ri];
                            grp_list = groups_in_row(r);
                            row_d = row_content_d(grp_list);
                            used_w = calc_sum([for(g=grp_list) group_content_w(g)]);
                            free_w = center_w - used_w;
                            gap_w = align_gap(free_w, len(grp_list), group_distance_X);
                            start_w = align_start(free_w, len(grp_list), group_distance_X);
                            row_start_x = center_start_x + start_w;
                            row_start_y = center_start_y + row_y_offset(ri);
                            for(k = [0:len(grp_list)-2]) {
                                i = grp_list[k];
                                x_center = row_start_x + cum_x_in_row(grp_list, k, gap_w) + group_content_w(i) + gap_w/2;
                                y_center = row_start_y + row_d/2;
                                translate([x_center, y_center, lid_height - label_depth])
                                    linear_extrude(height = label_depth + eps)
                                        square([label_border_thickness, row_d + 2 * border_offset], center = true);
                            }
                        }
                    }
                }
                
                if (autogenerate_labels == 1) {
                    for (p = label_positions()) place_group_label(p[0], p[1], p[2], p[4]-p[3], p[6]-p[5]);
                }
                
                if (lid_separators > 0) {
                    sep_h = lid_height - outer_wall_thickness - lid_lip_height;
                    sep_h_top = sep_h + eps;
                    translate([0, 0, lid_lip_height])
                    intersection() {
                        translate([0, 0, 0])
                            box_profile(box_w - 2*outer_wall_thickness + 0.1, box_d - 2*outer_wall_thickness + 0.1, sep_h_top, max(0.1, corner_radius - outer_wall_thickness), 0, 0);
                        union() {
                            for (p = label_positions()) {
                                let(
                                    xmin = p[3], xmax = p[4],
                                    ymin = p[5], ymax = p[6],
                                    w = xmax - xmin,
                                    d = ymax - ymin
                                )
                                translate([0, 0, sep_h_top/2]) {
                                    if (xmin > wall_left + 0.1) translate([xmin, (ymin+ymax)/2, 0]) cube([lid_separator_thickness, d + lid_separator_thickness, sep_h_top], center=true);
                                    if (xmax < wall_right - 0.1) translate([xmax, (ymin+ymax)/2, 0]) cube([lid_separator_thickness, d + lid_separator_thickness, sep_h_top], center=true);
                                    if (ymin > wall_bottom + 0.1) translate([(xmin+xmax)/2, ymin, 0]) cube([w + lid_separator_thickness, lid_separator_thickness, sep_h_top], center=true);
                                    if (ymax < wall_top - 0.1) translate([(xmin+xmax)/2, ymax, 0]) cube([w + lid_separator_thickness, lid_separator_thickness, sep_h_top], center=true);
                                }
                            }
                            
                            if (lid_separators == 2) {
                                for (p = label_positions()) {
                            
                                  let(
                                        i = p[0],
                                        cx = p[1],
                                        cy = p[2],
                                        xmin = p[3],
                                        xmax = p[4],
                                        ymin = p[5],
                                        ymax = p[6],
                                        bt = g_types[i],
                                        pocket = group_pocket_depth(i),
                                        local_req = get_h(i) - pocket + lid_battery_clearance
                                    )
                                    if (is_coin_type(bt) || (bt >= 24 && bt <= 34)) {
                                        if (local_req < sep_h - 0.1) {
                                            translate([cx, cy, local_req + (sep_h_top - local_req)/2])
                                                cube([xmax - xmin + 0.1, ymax - ymin + 0.1, sep_h_top - local_req], center=true);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}